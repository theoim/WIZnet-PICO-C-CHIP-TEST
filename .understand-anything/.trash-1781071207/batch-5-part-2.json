    {
      "id": "file:port/ioLibrary_Driver/src/wizchip_qspi_pio.c",
      "type": "file",
      "name": "wizchip_qspi_pio.c",
      "filePath": "port/ioLibrary_Driver/src/wizchip_qspi_pio.c",
      "summary": "Implements the WIZnet QSPI PIO driver for RP2040/RP2350: opens/closes PIO state machines and DMA channels for W6300 QSPI quad-mode communication, provides frame-level CS management, and exposes read/write byte and buffer transfer functions.",
      "tags": ["hardware-driver", "spi", "pio", "service"],
      "complexity": "complex",
      "languageNotes": "Uses RP2040 PIO + DMA for high-throughput QSPI transfers; supports SPI, dual-SPI, and quad-SPI modes selected at open time via the spi_config structure."
    },
    {
