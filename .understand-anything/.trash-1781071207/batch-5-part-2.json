      "filePath": "port/ioLibrary_Driver/src/wizchip_qspi_pio.c",
      "lineRange": [180, 358],
      "summary": "Allocates and configures PIO state machines and DMA channels for the requested SPI mode (SPI/dual/quad), setting GPIO functions, clock dividers, and shift register directions.",
      "tags": ["initialization", "hardware-driver", "spi"],
      "complexity": "complex"
    },
    {
